docker.enabled = true

workflow.output.mode = 'copy'
outputDir = "results_gatk_wes"

profiles {
    test {
        process {
            withName: "BWA_MEM_AND_MERGE_ALIGNMENT" {
                memory = 6.GB
                cpus = 6
            }
            withName: "BASE_RECALIBRATOR" {
                memory = 3000.MB
            }
            withName: "APPLY_BQSR" {
                memory = 2000.MB
            }
            withName: "HAPLOTYPE_CALLER" {
                memory = 4000.MB
            }
        }
        params {
            sample_name = "NA12878"
            unmapped_bams = [
                "../../data/samples/NA12878_A.bam",
                "../../data/samples/NA12878_B.bam",
                "../../data/samples/NA12878_C.bam"
            ]
            use_bwa_mem = true
            perform_bqsr = true
            hard_clip_reads = false
            unmap_contaminant_reads = true
            bin_base_qualities = true
            allow_empty_ref_alt = false
            use_spanning_event_genotyping = true
            run_dragen_mode_variant_calling = false
            skip_reblocking = false
            use_dragen_hard_filtering = false
            save_bamout = false
            haplotype_scatter_count = 5
            break_bands_at_multiples_of = 0
            ref_fasta = "../../data/references/Homo_sapiens_assembly38.fasta"
            ref_fasta_index = "../../data/references/Homo_sapiens_assembly38.fasta.fai"
            ref_dict = "../../data/references/Homo_sapiens_assembly38.dict"
            ref_alt = "../../data/references/Homo_sapiens_assembly38.fasta.64.alt"
            ref_amb = "../../data/references/Homo_sapiens_assembly38.fasta.64.amb"
            ref_ann = "../../data/references/Homo_sapiens_assembly38.fasta.64.ann"
            ref_bwt = "../../data/references/Homo_sapiens_assembly38.fasta.64.bwt"
            ref_pac = "../../data/references/Homo_sapiens_assembly38.fasta.64.pac"
            ref_sa = "../../data/references/Homo_sapiens_assembly38.fasta.64.sa"
            dbsnp_vcf = "../../data/recalibration/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
            dbsnp_vcf_index = "../../data/recalibration/Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi"
            known_indels_sites_vcfs = [
                "../../data/recalibration/Homo_sapiens_assembly38.known_indels.vcf.gz",
                "../../data/recalibration/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
            ]
            known_indels_sites_indices = [
                "../../data/recalibration/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi",
                "../../data/recalibration/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
            ]
            contamination_sites_bed = "../../data/contamination/1000g.phase3.100k.b38.vcf.gz.dat.bed"
            contamination_sites_mu = "../../data/contamination/1000g.phase3.100k.b38.vcf.gz.dat.mu"
            contamination_sites_ud = "../../data/contamination/1000g.phase3.100k.b38.vcf.gz.dat.UD"
            haplotype_database = "../../data/fingerprint/Homo_sapiens_assembly38.haplotype_database.txt"
            fingerprint_genotypes = "../../data/fingerprint/NA12878.hg38.reference.fingerprint.vcf"
            fingerprint_genotypes_index = "../../data/fingerprint/NA12878.hg38.reference.fingerprint.vcf.idx"
            calling_interval_list = "../../data/intervals/exome_calling_regions.v1.interval_list"
            evaluation_interval_list = "../../data/intervals/exome_evaluation_regions.v1.interval_list"
            target_interval_list = "../../data/intervals/whole_exome_illumina_coding_v1.Homo_sapiens_assembly38.targets.interval_list"
            bait_interval_list = "../../data/intervals/whole_exome_illumina_coding_v1.Homo_sapiens_assembly38.baits.interval_list"
        }
    }
}
